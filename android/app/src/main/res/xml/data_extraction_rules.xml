<?xml version="1.0" encoding="utf-8"?>
<!--
  LifeOS keeps financial data (transactions, SMS-import metadata) only on this
  device. Nothing is included in Google cloud backups or device-to-device
  transfers, so uninstalling removes it and a fresh install starts clean.
  Users who want a copy can use Settings → Export in the app.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
