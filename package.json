{
  "name": "angular-starter",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "serve:local": "node --experimental-transform-types --no-warnings --import ./src/app/features/salary-tax/tests/ts-extension-resolver.mjs scripts/serve-local.mjs",
    "test:calc": "node --experimental-strip-types --import ./src/app/features/salary-tax/tests/ts-extension-resolver.mjs src/app/features/salary-tax/tests/tax-engine.test.ts",
    "test:ai": "node --experimental-transform-types --no-warnings --import ./src/app/features/salary-tax/tests/ts-extension-resolver.mjs --test src/app/core/ai/tests/ai-core.test.ts src/app/core/ai/tests/ai-providers.test.ts src/app/core/ai/tests/ai-cancel.test.ts src/app/features/salary-tax/tests/tax-extraction.test.ts netlify/tests/ai-backend.test.ts scripts/tests/serve-local.test.mjs",
    "typecheck:functions": "tsc -p netlify/tsconfig.json",
    "test": "npm run test:calc && npm run test:ai && npm run typecheck:functions"
  },
  "dependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "@angular/service-worker": "21.2.23",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "dexie": "^4.4.6",
    "echarts": "^6.1.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.5.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.23",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.23",
    "typescript": "^5.9.3"
  }
}
